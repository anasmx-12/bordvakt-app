# Kopiera till .env och fyll i. Läses av AI.py.

SUPABASE_URL=https://DITT-PROJEKT.supabase.co
# Publik nyckel: räcker för att visa video (utan AI-analys)
SUPABASE_ANON_KEY=DIN_ANON_KEY
SUPABASE_SERVICE_KEY=DIN_SERVICE_ROLE_KEY
# Restaurangen som den här datorn bevakar (behövs bara om det finns flera restauranger)
RESTAURANT_ID=
FRAME_INTERVAL=1
STABLE_FRAMES=5
STREAM_PORT=8080
# Lokal AI: minuter utan mat innan "väntar på mat", sekunder efter avplockning innan dessertläge
FOOD_WAIT_MIN=15
DESSERT_DELAY_SEC=60

# --- Snabbhet och RAM (lokal AI)
# Modell för bordsanalys: tiny (standard), nano (minst RAM) eller s (noggrannast)
AI_MODEL=tiny
# Handuppräckning (on/off). off sparar ca 175 MB RAM när det sitter gäster.
HAND_DETECTION=on
# Akut läge / SOS (on/off): larmar när en gäst tappar ett glas eller en tallrik.
# Fungerar bäst med HAND_DETECTION=on (då ser AI:n om gästen reser sig eller böjer sig ned).
SOS_DETECTION=on
# Väntar på notan: minuter efter att maten plockats bort utan ny beställning
BILL_DELAY_MIN=7
# Bildbredd från kameran. 640 sparar RAM och CPU, 1280 ser små saker bättre.
CAMERA_WIDTH=1280
# Antal processorkärnor AI:n får använda
AI_THREADS=2

# Vakti (installationschatten) körs lokalt med Ollama. Byt modell här om du vill.
CHAT_MODEL=qwen3:4b-instruct

# --- Säker koppling till webbappen (engine_security.py, engine_tunnel.py)
# Webbappens adress(er), kommaseparerade. Bara de får läsa video och status i webbläsaren.
# Tomt = bara den egna datorn och det lokala nätet (utveckling).
WEB_ORIGINS=
# Tunnel till internet: auto (standard, kräver cloudflared) eller off
ENGINE_TUNNEL=auto
# Fast tunnel från Cloudflare (för drift). Utan dem används en snabbtunnel med slumpad adress.
CLOUDFLARE_TUNNEL_TOKEN=
ENGINE_PUBLIC_URL=
